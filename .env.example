# Firebase server access (Admin SDK). From the service account key file.
# Locally: copy to .env.local. On Vercel: Project settings -> Environment Variables.
FIREBASE_PROJECT_ID=vorapicks-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@vorapicks-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local development against the emulators instead (run `cd firebase && npm run emulators`):
# FIREBASE_PROJECT_ID=demo-vorapicks
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
