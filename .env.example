# Firebase service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=vorapicks-dev
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n for line breaks
FIREBASE_PRIVATE_KEY=
# Web API key (Project settings > General > Your apps > Vorapicks Admin (web)); used server-side for password sign-in
FIREBASE_WEB_API_KEY=
